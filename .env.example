# Safe placeholders only. Never put real credentials in this file.
# Browser-visible Supabase configuration (publishable key only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side Supabase configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me_with_server_secret

# Local Drizzle migrations only; never expose to browser builds.
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/database

# Optional authenticated cron endpoint secrets.
LOVABLE_CRON_SECRET=replace_me
LOVABLE_CRON_SECRET_PREVIOUS=
